<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to hidden files and sensitive directories
    RewriteRule ^(\.env|\.git|app|system|vendor|writable|tests|node_modules) - [F,L]

    # Forward all requests to public/
    RewriteCond %{REQUEST_URI} !^/HokiBrewCoffee/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
